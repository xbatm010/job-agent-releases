MICROSITE_CTA_WAIT_MS=3500
MICROSITE_CTA_RETRIES=3
ALLOW_SAME_HOST_REPLY_FALLBACK=true

# Application route safety
STRICT_APPLICATION_ROUTE_VALIDATION=true

# Czech cover / motivation letter
AUTO_CZECH_COVER_LETTER=true
COVER_LETTER_LANGUAGE=cs
COVER_LETTER_MAX_CHARS=1200

# Location gate
LOCATION_MODE=prague
ALLOWED_LOCATION_TERMS=Praha,Prague,Stodůlky,Stodulky,Praha-východ,Praha-západ,Říčany,Ricany
ALLOW_FULL_REMOTE_OUTSIDE_PRAGUE=true
BLOCKED_LOCATION_TERMS=Brno,Ostrava,Olomouc,Plzeň,Plzen,České Budějovice,Ceske Budejovice,Hradec Králové,Hradec Kralove,Pardubice,Zlín,Zlin,Liberec

# Sources
SOURCE_JOBS_CZ=true
SOURCE_PRACE_CZ=true
SOURCE_STARTUPJOBS_CZ=true
MAX_DISCOVERY_PER_SOURCE=80

# Application safety
AUTO_SUBMIT=false
CONFIRMATION_GATE=false
ALLOW_JOBS_HANDOFF=false
MANUAL_SUBMIT_HOLD=true
MANUAL_SUBMIT_WAIT_SECONDS=600

# Persistent shared history across all discovery sources
STATE_DIR=~/.job_agent

# Browser/session
LOGIN_BOOTSTRAP=true
LOGIN_WAIT_SECONDS=240
BROWSER_PROFILE_DIR=./browser_profile

# Diagnostics

# Browser-render evidence recovery for promising weak target jobs
BROWSER_EVIDENCE_RECOVERY=true
BROWSER_EVIDENCE_LEVELS=weak
MAX_BROWSER_EVIDENCE_JOBS=12
BROWSER_EVIDENCE_WAIT_MS=1800
BROWSER_DISCOVERY_RELOAD_LIMIT=5
APPLICATION_DEBUG=true
MANUAL_CV_FALLBACK=true
MANUAL_CV_WAIT_SECONDS=180

# PwC adapter values confirmed in previous runs
PWC_WORKED_BEFORE=
PWC_COUNTRY=
PWC_CITY=
PWC_GENDER=
PWC_FUTURE_RECRUITMENT_CONSENT=
PWC_EVENTS_CONSENT=
PWC_MANUAL_CHOICES_WAIT_SECONDS=180

WORKDAY_MANUAL_BOOTSTRAP=true
WORKDAY_WAIT_SECONDS=300

# Ranking
MIN_APPLY_SCORE=66
VERIFIED_TARGET_APPLY_SCORE=64
VERIFIED_TARGET_MIN_CANDIDATE_FIT=10
ENTRY_APPLY_SCORE=62
EXPANDED_APPLY_SCORE=70
EXPANDED_REVIEW_SCORE=58
EXPANDED_MIN_DATA_SIGNALS=3
EXPANDED_MIN_CANDIDATE_FIT=12
# Only explicit entry titles (Junior/Student/Intern/Trainee/Graduate).
EXPANDED_ENTRY_MIN_CANDIDATE_FIT=10
MAX_APPLICATIONS_PER_RUN=3
CONTINUE_AFTER_APPLICATION_ERROR=true
MIN_REVIEW_SCORE=55
MANUAL_REVIEW_APPLY_MIN_SCORE=65
MAX_JOBS_TO_REVIEW=36

CV_PATH=

